    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.23.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.0.5"
